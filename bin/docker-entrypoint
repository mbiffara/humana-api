#!/bin/bash -e

# Enable running one-off commands like:
#   docker run <image> ./bin/rails db:migrate
#   ECS run-task --overrides '{"containerOverrides":[{"command":["./bin/rails","db:migrate"]}]}'
#
# When the container starts normally (rails server), it boots immediately
# without blocking on migrations. Migrations run as a separate step in CI/CD.

exec "${@}"
