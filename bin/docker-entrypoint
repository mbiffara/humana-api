#!/bin/bash -e

# Run pending migrations and seeds before starting the server.
# The task definition health check (startPeriod: 90s) gives enough
# time for this to complete before ECS starts checking /up.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
